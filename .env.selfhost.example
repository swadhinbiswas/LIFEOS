# LifeOS self-host environment — the two-command path.
#
#   cp .env.selfhost.example .env.selfhost && $EDITOR .env.selfhost
#   docker compose --env-file .env.selfhost up -d
#
# `docker compose` reads this file for interpolation only; the container's own environment is set
# explicitly in docker-compose.yml. A distinct name from `.env` is deliberate: compose would
# otherwise pick up a developer's local file and this stack could end up pointed at their database.
#
# For the non-Docker path see .env.example, which documents every variable with the ADR that
# introduced it. This file is the short one.

# --- The only two required. -------------------------------------------------------------

# `openssl rand -base64 32`. Rotating it signs everybody out and invalidates nothing else, so it is
# safe to change; changing it means everyone signs in again.
BETTER_AUTH_SECRET=

# The port on the host, and the URL the browser uses. They must agree, or sign-in returns
# 403 INVALID_ORIGIN (ADR-092) — Better Auth trusts its base URL and TRUSTED_ORIGINS and nothing else.
LIFEOS_PORT=3000
LIFEOS_URL=http://localhost:3000

# --- Optional, and each buys something specific. docs/SELF_HOSTING.md says what. -------------

# A scheduler calls the /api/cron/* routes with `Authorization: Bearer $CRON_SECRET`. Without it
# those routes return 404 and no scheduled work runs. `openssl rand -base64 32`.
CRON_SECRET=

# Redis is what makes sessions, rate limits and idempotency keys survive a restart and be shared
# between replicas. Without it the app still runs, on an in-memory Map. Not required for one
# container on one box; required for two or more replicas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email. Without it, verification and reset links are written to /data/outbox/ inside the volume
# and logged — workable, but you read them off the host.
RESEND_API_KEY=
EMAIL_FROM=

# AI. Any one of these; the app works with none and hides the AI surfaces. The key format is a
# base64-encoded 32 bytes. **Generate once and keep it** — rotating it makes every stored WakaTime
# key and AI credential unreadable, and there is no re-encryption path.
AI_ENCRYPTION_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
COMMANDCODE_API_KEY=
ATTACHMENTS_DIR=
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
