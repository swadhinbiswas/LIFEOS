.env
.env.*
!.env.example
# ADR-131 named this file as a committed deliverable and docs/SELF_HOSTING.md tells people to
# `cp .env.selfhost.example .env.selfhost`, but `.env.*` above swallowed it: the file existed on
# disk and had never been tracked, so the instruction failed on a fresh clone. The ADR was right
# and the ignore rule was not.
!.env.selfhost.example
node_modules/
.next/
coverage/
*.log
.DS_Store
.data/
*.tsbuildinfo
playwright-report/
# Lighthouse CI writes its own reports and cache here; they are run artifacts.
.lighthouseci/
test-results/
# Human-inspection output for `pnpm e2e:visual`; see playwright.visual.ts. Kept out of
# test-results/ because that directory is cleared at the start of every run.
visual-shots/
tests/e2e/.e2e.db*

playwright.local.ts
