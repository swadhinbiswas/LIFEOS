{
  "name": "lifeos",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "lifeos": "src/cli/index.ts"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/dev-migrate.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config vitest.evals.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --config=playwright.visual.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "cli": "tsx src/cli/index.ts",
    "load": "node scripts/load.mjs",
    "lighthouse": "pnpm dlx @lhci/cli autorun",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai": "4.0.102",
