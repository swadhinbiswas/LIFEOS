    "next-intl": "4.14.9",
    "nuqs": "2.10.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "rrule": "2.8.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "ulid": "3.0.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
