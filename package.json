    "@ai-sdk/react": "4.0.157",
    "@better-auth/drizzle-adapter": "1.7.13",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@dodopayments/nextjs": "0.3.9",
    "@hookform/resolvers": "5.9.1",
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "ai": "7.0.153",
    "better-auth": "1.7.13",
    "chrono-node": "2.10.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "docx": "9.14.0",
    "dodopayments": "2.57.0",
    "drizzle-orm": "0.45.4",
    "fractional-indexing": "4.0.0",
    "geist": "1.8.2",
    "imapflow": "^2.9.1",
    "lucide-react": "1.61.0",
