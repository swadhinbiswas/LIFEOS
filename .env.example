# LifeOS environment — copy to .env and fill in. Never commit .env (keys only here, no values).

# --- Database (ADR-020, ADR-121) ---
# Local dev: a file URL, relative paths resolve from the repo root.
#   DATABASE_URL=file:.data/lifeos.db
# Turso: the libsql:// URL *and* the token as two separate values. The host is not a secret and
# the token is, so keeping them apart means the URL can be printed, diffed and pasted into a
# runbook. A token embedded as ?authToken= in the URL also works, but then the URL is a secret
# and `env.ts` cannot warn you about the mismatch below.
DATABASE_URL=
TURSO_AUTH_TOKEN=

# TURSO_AUTH_TOKEN is only valid with a libsql:// or https:// DATABASE_URL; `env.ts` fails
# validation if it is set alongside a file: URL, which is also what keeps the acceptance suite
# from ever reaching a real database (tests/e2e/global-setup.ts strips it).

# --- Better Auth (ADR-030): required in production; dev falls back to a local secret ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Auth rate limit (ADR-039): optional ceiling for /sign-in*, /sign-up*, reset mail.
# Leave empty for Better Auth's defaults (3 / 10 s); the E2E run sets 100. ---
AUTH_RATE_LIMIT_MAX=

# --- App URL ---
NEXT_PUBLIC_APP_URL=

# --- Trusted origins (ADR-092): extra origins allowed for sign-in/up, comma-separated.
# Only needed when the app is reached on a host other than NEXT_PUBLIC_APP_URL (a LAN IP,
# a tunnel, a second domain). Development already trusts this machine's own addresses. ---
TRUSTED_ORIGINS=

# --- Upstash Redis (ADR-021): both or neither; missing = in-memory dev fallback ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (ADR-022): RESEND_API_KEY present = Resend, absent = file outbox in .data/outbox ---
RESEND_API_KEY=
EMAIL_FROM=

# --- OAuth (ADR-023): both per provider or the buttons stay hidden ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (ADR-013): keep false until Dodo go-live ---
BILLING_ENABLED=

# --- Cron secret (ADR-069/078): guards GET /api/cron/webhooks and /api/cron/proactive;
# unset = both routes return 404 ---
CRON_SECRET=
# ADR-135: outgoing webhooks refuse loopback, private and link-local targets (and cloud metadata
# endpoints) so user-supplied URLs cannot make the server probe its own network. Set true only on a
# development machine that delivers webhooks to a local listener; never in a deployment.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
# --- AI copilot (ADR-073…078) ---
# ADR-074: 32-byte base64 key for AES-256-GCM at-rest secrets (openssl rand -base64 32).
# Unset: dev/test derives a key from BETTER_AUTH_SECRET; production disables saving keys.
AI_ENCRYPTION_KEY=
# ADR-076: HMAC key that binds tool approvals to the server (openssl rand -base64 32).
TOOL_APPROVAL_SECRET=
# ADR-075: deterministic scripted model for dev/demo/e2e when no provider key exists.
AI_SCRIPTED=

# --- AI providers (optional; any one enables that provider for every user) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
# Command Code Provider API: one key, every top model. Claude answers on /v1/messages and the rest
# on /v1/chat/completions; the app routes per model (ADR-134). Get a key at
# https://app.commandcode.ai — see https://docs.commandcode.ai for endpoints and pricing.
COMMANDCODE_API_KEY=
# Ollama / any OpenAI-compatible endpoint (base URL + optional key)
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_API_KEY=
# Where uploaded attachment bytes live (default /data/attachments). Back up with the database volume.
ATTACHMENTS_DIR=
# Defaults used when a user has not chosen (provider: openai|anthropic|google|openrouter|commandcode|compatible)
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=

# --- Billing (ADR-013/080): hidden unless BILLING_ENABLED=true AND the Dodo keys are set ---
# Use test_mode credentials only until merchant eligibility is confirmed (ADR-013).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_RETURN_URL=
DODO_PAYMENTS_ENVIRONMENT=
# Product ids from the Dodo dashboard; a plan without one is not offered.
DODO_PRODUCT_PRO=
DODO_PRODUCT_TEAM=
