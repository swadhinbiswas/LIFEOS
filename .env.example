# LifeOS environment — copy to .env and fill in. Never commit .env (keys only here, no values).

# --- Database (ADR-020): file: for local/dev, libsql:// + token for Turso ---
DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Better Auth (ADR-030): required in production; dev falls back to a local secret ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Auth rate limit (ADR-039): optional ceiling for /sign-in*, /sign-up*, reset mail.
# Leave empty for Better Auth's defaults (3 / 10 s); the E2E run sets 100. ---
AUTH_RATE_LIMIT_MAX=

# --- App URL ---
NEXT_PUBLIC_APP_URL=

# --- Upstash Redis (ADR-021): both or neither; missing = in-memory dev fallback ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (ADR-022): RESEND_API_KEY present = Resend, absent = file outbox in .data/outbox ---
RESEND_API_KEY=
EMAIL_FROM=

# --- OAuth (ADR-023): both per provider or the buttons stay hidden ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (ADR-013): keep false until Dodo go-live ---
BILLING_ENABLED=
